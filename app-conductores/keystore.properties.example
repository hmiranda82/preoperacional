# ─────────────────────────────────────────────────────────────
# PREOPERACIONAL — Firma del APK/AAB de producción
# ─────────────────────────────────────────────────────────────
# COPIA este archivo a `keystore.properties` y rellena los valores.
# `keystore.properties` NO se versiona (ver app-conductores/.gitignore).
# GUARDA el .jks y estas credenciales en un sitio seguro para siempre:
# un keystore perdido = no poder actualizar la app publicada.
#
# Pasos:
#   1. Genera el keystore UNA sola vez:
#        cd app-conductores/android
#        keytool -genkey -v -keystore preoperacional-release.jks \
#          -alias preoperacional -keyalg RSA -keysize 2048 -validity 10000
#   2. Copia este archivo como `keystore.properties` (en app-conductores/)
#   3. Reemplaza los valores con los que elegiste en keytool.
#
# `storeFile` es RELATIVO a app-conductores/ (el gradle lo lee con rootProject.file('../'+storeFile)).
# Recomendado: guarda el .jks junto a este archivo (app-conductores/preoperacional-release.jks).
storeFile=preoperacional-release.jks
storePassword=CAMBIA_ESTA_CONTRASENA
keyAlias=preoperacional
keyPassword=CAMBIA_ESTA_CONTRASENA