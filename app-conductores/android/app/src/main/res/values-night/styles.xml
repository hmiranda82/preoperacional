<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Modo oscuro: la franja del status bar y el splash usan el navy de la
         app (iconos blancos). El resto de la interfaz sigue con su tema claro
         fijo (Theme.AppCompat.Light.NoActionBar). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">#0d1422</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="windowSplashScreenBackground">#0d1422</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>