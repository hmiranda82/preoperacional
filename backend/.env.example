# ==========================================
# BACKEND - VARIABLES DE ENTORNO
# ==========================================
# Copia este archivo a .env y ajusta los valores
# NUNCA commitees el archivo .env al repositorio
# ==========================================

# ── Base de datos ────────────────────────
# Formato: mysql://usuario:password@host:puerto/base_de_datos
# NUNCA uses root:root en producción
DATABASE_URL="mysql://preop_user:TU_PASSWORD_SEGURA@localhost:3306/preoperacional"

# ── JWT ───────────────────────────────────
# Genera un secreto fuerte:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CAMBIA_ESTO_POR_UNA_CLAVE_DE_64_CARACTERES_ALEATORIA"
JWT_EXPIRES_IN="8h"

# ── Servidor ─────────────────────────────
PORT=3000
NODE_ENV=development

# ── API ───────────────────────────────────
# URL pública del backend (accesible desde dispositivos móviles en la misma red)
API_URL="http://192.168.20.22:3000"

# ── CORS ──────────────────────────────────
# Lista separada por comas de orígenes permitidos
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,capacitor://localhost,http://localhost"

