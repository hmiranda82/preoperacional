# ───────────────────────────────────────────────
# PREOPERACIONAL — Plantilla de producción (VPS)
# ───────────────────────────────────────────────
# Copia este archivo como .env en la raíz del proyecto EN EL VPS
# y llena TODOS los valores. NUNCA lo subas al repositorio.
# Generador de secretos: openssl rand -base64 24
# Generador JWT:        openssl rand -hex 64

# Contraseña root de MySQL (mín. 20 caracteres)
MYSQL_ROOT_PASSWORD=

# Contraseña del usuario app de MySQL (mín. 20 caracteres)
MYSQL_APP_PASSWORD=

# Tu dominio real (sin https://, ej: preoperacional.com)
DOMINIO=

# Secreto JWT (mín. 32 caracteres; en producción se exige ≥32)
JWT_SECRET=

# ── Primer arranque ─────────────────────────────
# true SOLO en el primer arranque: siembra la empresa, el formulario
# (12 preguntas) y el SUPER_ROOT (root@system.local) con cambio de
# contraseña obligatorio al primer login.
# Después del primer arranque vuelve a ponerlo en false.
RUN_SEED=true

# Contraseña TEMPORAL del SUPER_ROOT para el seed (mín. 8 caracteres).
# REQUERIDA cuando RUN_SEED=true y NODE_ENV=production.
# El sistema la obligará a cambiar en el primer inicio de sesión.
# Genera una nueva (openssl rand -base64 24); NO reutilices contraseñas.
SUPER_ROOT_PASSWORD=

# Opcional: DSN de Sentry para error tracking
SENTRY_DSN=

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info
